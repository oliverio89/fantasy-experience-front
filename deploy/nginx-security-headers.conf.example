# Incluir dentro del bloque `server` HTTPS que sirve Fantasy Experience.
# El hash permite exclusivamente el JSON-LD estático actual de index.html.
# Si se modifica ese bloque, recalcular el SHA-256 antes de desplegar.
server_tokens off;

add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
add_header X-Content-Type-Options "nosniff" always;
add_header X-Frame-Options "DENY" always;
add_header Referrer-Policy "strict-origin-when-cross-origin" always;
add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
add_header Cross-Origin-Opener-Policy "same-origin" always;
add_header Cross-Origin-Resource-Policy "same-site" always;
add_header X-XSS-Protection "0" always;
add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' 'sha256-jJovNF3jo6GD04F/a/pdXf6Wgh42BaIvkaqYCos8uwY='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://*.supabase.co https://img.youtube.com; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.web3forms.com; frame-src https://www.youtube-nocookie.com; worker-src 'self' blob:; form-action 'self'; upgrade-insecure-requests" always;

# Evita cachear el shell HTML y da larga duración a los assets con hash.
location = /index.html {
  expires -1;
}

location /assets/ {
  expires 1y;
  try_files $uri =404;
}
